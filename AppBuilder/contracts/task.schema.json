{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppBuilder Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "acceptance_criteria"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    }
  }
}
