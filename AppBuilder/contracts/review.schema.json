{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppBuilder Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "checks"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_for_release": {
      "type": "boolean",
      "default": false
    }
  }
}
